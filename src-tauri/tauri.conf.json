{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActivityMux",
  "version": "0.2.1",
  "identifier": "com.naxecode.activitymux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ActivityMux",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: asset:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Route running applications into one Discord Rich Presence.",
    "longDescription": "ActivityMux is a cross-platform Discord Rich Presence controller with presets, process rules, deterministic priorities, persistent timers, and manual overrides.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxNDY0MDIwOEVFQTdENzYKUldSMmZlcU9JRUJHY2RzNHRBM1lHTk92K2ZHR21ySjF1akt5dnFUV1Q0eTBxdmxkZ0pXQjQ1dWwK",
      "endpoints": [
        "https://github.com/NaxeCode/activitymux/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
